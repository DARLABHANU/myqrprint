PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/printly
SESSION_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Google Identity Services sign-in (same client ID is exposed to the browser as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Gmail API (HTTPS) works on Render Free; OAuth scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=Printly <sender@gmail.com>
# Optional SMTP fallback for hosts that permit outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Platform Admin & Subscription Billing
ADMIN_EMAIL=daarlabhanumurthy@gmail.com
ADMIN_SETTLEMENT_TOKEN=
ADMIN_SETTLEMENT_PASSWORD=
PLATFORM_UPI_ID=daarlabhanumurthy@okaxis
PLATFORM_ACCOUNT_NAME=Printly Platform

# Razorpay: use matching credentials from either Test Mode or Live Mode.
# Production (NODE_ENV=production) accepts only rzp_live_ keys.
# Configure a webhook at https://printly-api.onrender.com/api/payments/razorpay/webhook
# and subscribe to payment.captured. Store the webhook signing secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
